# Uso local (opcional; sem este arquivo o admin local usa admin123)
ADMIN_PASSWORD=admin123
SESSION_SECRET=troque-por-uma-chave-longa-e-aleatoria-em-producao

# Supabase e OPCIONAL no desenvolvimento local.
# Na Vercel, configure os dois valores abaixo com os dados REAIS do seu projeto.
# Nao use literalmente os textos de exemplo.
# SUPABASE_URL=https://SEU-ID-REAL.supabase.co
# Chave privada de servidor (sb_secret_...). Nunca use a chave publishable neste campo.
# SUPABASE_SECRET_KEY=SUA_SECRET_KEY_REAL
# SUPABASE_SERVICE_ROLE_KEY=SUA_SERVICE_ROLE_KEY_REAL

# REAL OFICIAL - MINI IA DE EDIÇÃO & BIBLIOTECA DE SFX / ÁUDIO
# Cole o token de autenticação fornecido pelo Real Oficial para puxar automaticamente
# efeitos sonoros (SFX), transições, risers, trilhas e elementos da CDN oficial:
REAL_OFICIAL_TOKEN=seu_token_real_oficial_aqui
# REAL_OFICIAL_API_URL=https://api.realoficial.com.br

