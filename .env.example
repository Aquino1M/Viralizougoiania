# Supabase e opcional no desenvolvimento local.\n# Na Vercel, configure os dois valores abaixo com os dados REAIS do seu projeto.\n# Nao use literalmente os textos de exemplo.\n# SUPABASE_URL=https://SEU-ID-REAL.supabase.co\n# SUPABASE_SERVICE_ROLE_KEY=SUA_SERVICE_ROLE_KEY_REAL\n
# Opcional: segredo exclusivo para assinar URLs do proxy de imagens.
# IMAGE_PROXY_SECRET=gere-uma-chave-longa-e-aleatoria

# Reescrita automática das matérias importadas.
# OPENAI_API_KEY=sua-chave-da-api
# OPENAI_REWRITE_MODEL=gpt-5.6-luna
